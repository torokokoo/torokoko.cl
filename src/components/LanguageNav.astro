---
import { languages, otherLang, type Lang } from "../data/site";

interface Props {
	lang: Lang;
	currentPath?: string;
	alternatePath?: string;
}

const { lang, currentPath = languages[lang].homePath, alternatePath } = Astro.props;
const nextLang = otherLang(lang);
const nextPath = alternatePath ?? languages[nextLang].homePath;
const contactPath = currentPath === languages[lang].homePath ? "#contact" : `${languages[lang].homePath}#contact`;
---

<nav class="site-nav" aria-label="Primary navigation">
	<a href={languages[lang].homePath}>{lang === "es" ? "inicio" : "home"}</a>
	<a href={languages[lang].blogPath}>blog</a>
	<a href={contactPath}>{lang === "es" ? "contacto" : "contact"}</a>
	<a aria-current="page" href={currentPath}>{languages[lang].shortLabel}</a>
	<a href={nextPath}>{languages[nextLang].shortLabel}</a>
</nav>
