---
import { homeCopy, languages, profile, type Lang } from "../data/site";
import { projects } from "../data/projects";
import type { BlogPost } from "../lib/posts";
import LanguageNav from "./LanguageNav.astro";
import PostList from "./PostList.astro";
import ProjectList from "./ProjectList.astro";
import RetroWindow from "./RetroWindow.astro";

interface Props {
	lang: Lang;
	posts: BlogPost[];
	homePath?: string;
}

const { lang, posts, homePath = languages[lang].homePath } = Astro.props;
const copy = homeCopy[lang];
---

<div class="site-shell">
	<div class="marquee" aria-label={copy.marquee}>
		<span>{copy.marquee}</span>
	</div>

	<header class="site-header">
		<a class="brand" href={homePath}>
			<span aria-hidden="true" class="brand-square"></span>
			{profile.handle}
		</a>
		<LanguageNav lang={lang} currentPath={homePath} homePath={homePath} />
	</header>

	<main id="content" class="home-grid">
		<section class="hero-panel" aria-labelledby="home-title">
			<div class="hero-copy">
				<p class="small-label">{copy.eyebrow}</p>
				<h1 id="home-title" class="rainbow-text">{copy.headline}</h1>
				<p class="hero-intro">{copy.intro}</p>
				<p class="availability"><span aria-hidden="true"></span>{copy.availability}</p>
				<div class="hero-actions">
					<a class="button-95" href={`mailto:${profile.email}`}>{copy.emailLabel}</a>
					<a class="button-95" href={profile.resumeEs}>{copy.resumeLabel}</a>
				</div>
			</div>

			<div class="portrait-window" aria-label={`${profile.name} portrait`}>
				<div class="window-titlebar">
					<span>me.webp</span>
					<span aria-hidden="true" class="window-controls"><i></i><i></i><i></i></span>
				</div>
				<img src={profile.portrait} alt={`Illustrated portrait of ${profile.name}`} />
				<div class="counter" aria-label="Visual hit counter">
					<span>0</span><span>0</span><span>0</span><span>9</span><span>5</span><span>0</span>
				</div>
			</div>
		</section>

		<RetroWindow title={copy.aboutTitle}>
			<dl class="profile-list">
				{copy.aboutItems.map(([label, value]) => (
					<>
						<dt>{label}</dt>
						<dd>{value}</dd>
					</>
				))}
			</dl>
		</RetroWindow>

		<RetroWindow title={copy.projectsTitle} id="projects" class="projects-preview">
			<ProjectList projects={projects} lang={lang} />
		</RetroWindow>

		<RetroWindow title={copy.blogTitle} class="blog-preview">
			<PostList posts={posts} lang={lang} emptyLabel={copy.noPosts} />
			<a class="button-95 blog-button" href={languages[lang].blogPath}>{copy.blogCta}</a>
		</RetroWindow>
	</main>

	<footer class="site-footer">
		<span aria-hidden="true">/////</span>
		<span>{profile.name} / {profile.location}</span>
		<span aria-hidden="true">\\\\\</span>
	</footer>
</div>
