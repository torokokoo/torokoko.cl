---
import HomeContent from "../../components/HomeContent.astro";
import { homeCopy, isLang, languages, type Lang } from "../../data/site";
import { getPosts } from "../../lib/posts";
import Layout from "../../layouts/Layout.astro";

export function getStaticPaths() {
	return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const langParam = Astro.params.lang;
if (!isLang(langParam)) {
	return Astro.redirect("/");
}

const lang: Lang = langParam;
const copy = homeCopy[lang];
const posts = await getPosts(lang, 3);
---

<Layout
	title={copy.metaTitle}
	description={copy.metaDescription}
	lang={lang}
	canonicalPath={languages[lang].homePath}
	alternates={[
		{ lang: "x-default", href: "/" },
		{ lang: "es", href: languages.es.homePath },
		{ lang: "en", href: languages.en.homePath },
	]}
>
	<HomeContent lang={lang} posts={posts} />
</Layout>
